<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.gp.controller.ProductosController"
            prefWidth="900.0"
            prefHeight="600.0">

    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets top="20.0" right="20.0"
                        bottom="10.0" left="20.0"/>
            </padding>

            <Label text="GESTIÓN DE PRODUCTOS"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="JavaFX - JDBC - MySQL"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="10.0" right="25.0"
                        bottom="20.0" left="25.0"/>
            </padding>

            <GridPane hgap="10.0" vgap="10.0">

                <Label text="ID:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtId"
                           promptText="ID del producto"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Nombre:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtNombre"
                           promptText="Nombre del producto"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Descripción:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtDescripcion"
                           promptText="Descripción del producto"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Precio:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="txtPrecio"
                           promptText="Precio"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Stock:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="txtStock"
                           promptText="Stock"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

            </GridPane>

            <HBox alignment="CENTER" spacing="10.0">

                <Button text="Guardar"
                        onAction="#guardarProducto"/>

                <Button text="Buscar"
                        onAction="#buscarProducto"/>

                <Button text="Actualizar"
                        onAction="#actualizarProducto"/>

                <Button text="Eliminar"
                        onAction="#eliminarProducto"/>

                <Button text="Limpiar"
                        onAction="#limpiarCampos"/>

                <Button text="Listar"
                        onAction="#listarProductos"/>

            </HBox>

            <TableView fx:id="tablaProductos"
                       prefHeight="300.0">

                <columns>

                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="70.0"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="160.0"/>

                    <TableColumn fx:id="colDescripcion"
                                 text="Descripción"
                                 prefWidth="300.0"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="120.0"/>

                    <TableColumn fx:id="colStock"
                                 text="Stock"
                                 prefWidth="100.0"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>